# Local runs only. On GitHub, put these in Settings > Secrets and variables > Actions.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-never-put-this-in-the-admin-page
# AI rewriting. Free route: a Gemini key from Google AI Studio. Several keys = tried in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini,groq   (optional; default is every provider that has a key)
# AI_MODEL=gemini-2.5-flash (optional; change it if Google retires the name)
ANTHROPIC_MODEL=claude-sonnet-5-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_URL=https://your-admin-host.example/
IG_USER_ID=
IG_ACCESS_TOKEN=
# Instagram Login token: https://graph.instagram.com   Facebook Login token: https://graph.facebook.com
GRAPH_HOST=https://graph.instagram.com
GRAPH_VERSION=v23.0
BRAND_NAME=Tri News
BRAND_HANDLE=@trinews
BRAND_TAG=TriNews
PARENT_NAME=TriBridge Services
BRAND_BG=#0A2A1F
BRAND_ACCENT=#FF5A36
MIN_SCORE=40
MAX_AI_PER_RUN=15
NOTIFY_MIN=70
MAX_POSTS_PER_RUN=2
